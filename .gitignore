# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# user-uploaded images (persisted on the server, not tracked in git)
/public/uploads/*
!/public/uploads/.gitkeep

# application logs (written at runtime, rotated in place)
/logs/*
!/logs/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

docs/database
.codegraph
# artefak deployment Docker (ada di VPS, bukan di repo)
/mysql-data/
/uploads/
/backups/
