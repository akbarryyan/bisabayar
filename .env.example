# ─────────────────────────────────────────────────────────────────────────────
# Contoh konfigurasi. Salin ke .env.local (dev) atau .env.production (VPS).
#
# PENTING — banyak konfigurasi TIDAK tinggal di sini.
#
# Kredensial gateway dan provider, mode mock/real, pengaturan SMTP, dan fee
# platform disimpan di tabel `site_configs` dan diubah lewat /admin/settings.
# Nilai di berkas ini hanya dipakai sebagai CADANGAN ketika kuncinya belum ada
# di database. Lihat lib/site-config.ts.
#
# Akibatnya: mengganti kredensial produksi dilakukan lewat halaman admin, bukan
# dengan menyunting berkas ini.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ WAJIB ═══════════════════════════════════════════════════════════════════
# Tanpa dua ini server MENOLAK menyala (lihat validateEnvironment di
# instrumentation.ts) — dan itu disengaja, karena tanpa keduanya aplikasi rusak
# secara senyap: storefront tetap terlihat sehat sementara login, checkout
# wallet, dan seluruh halaman admin tidak berfungsi.

DATABASE_URL="mysql://user:password@127.0.0.1:3306/whuzpay"

# Minimal 32 karakter. Dipakai iron-session untuk menyegel cookie sesi.
# Menggantinya membuat SEMUA sesi yang berjalan menjadi tidak valid.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"


# ═══ URL APLIKASI ════════════════════════════════════════════════════════════
# Di produksi WAJIB https. Kalau tidak, cookie sesi tidak disetel Secure dan
# login tidak akan menempel di browser yang mengakses lewat https
# (lihat shouldUseSecureCookies di lib/session.ts). Server memperingatkan ini
# saat menyala.
APP_URL="https://contoh.com"
NEXT_PUBLIC_APP_URL="https://contoh.com"
NEXT_PUBLIC_BASE_URL="https://contoh.com"

APP_ENV=local
APP_NAME="Whuzpay"
NEXT_PUBLIC_APP_NAME="Whuzpay"
HEADER_COLOR="#003D99"


# ═══ PROVIDER PPOB ═══════════════════════════════════════════════════════════
# Mode dan kredensial lebih diutamakan dari site_configs; nilai di sini cadangan.
# "mock" memakai adapter tiruan dan tidak memotong saldo provider sungguhan.
PROVIDER_DIGIFLAZZ_MODE=mock
PROVIDER_VIP_MODE=mock

DIGIFLAZZ_USERNAME=""
DIGIFLAZZ_API_KEY=""
DIGIFLAZZ_BASE_URL="https://api.digiflazz.com/v1"

VIP_API_ID=""
VIP_API_KEY=""
VIP_SIGN=""
VIP_BASE_URL="https://vip-reseller.co.id/api"

# Verifikasi signature callback VIP. Bawaannya "true" — callback tanpa header
# X-Client-Signature yang sah ditolak 401.
#
# Setel "false" HANYA bila VIP ternyata tidak mengirim header itu. Nilai di
# site_configs menimpa yang di sini, jadi ubahnya lewat /admin/settings supaya
# berlaku tanpa deploy.
#
# Perlu diketahui: signature VIP adalah md5(API_ID + API_KEY) — statis dan tidak
# terikat payload, jadi ia membuktikan pengirim tahu kredensial, bukan bahwa
# pesannya baru. Perlindungan kiriman ulang datang dari WebhookEvent.
VIP_WEBHOOK_SIGNATURE_REQUIRED=true

# Perilaku adapter tiruan saat mode mock.
MOCK_PROVIDER_SCENARIO=pending_then_success
MOCK_PROVIDER_DELAY_MS=1500


# ═══ PAYMENT GATEWAY — POPPAY ════════════════════════════════════════════════
# Satu-satunya gateway yang dipakai. Integrasi Pakasir sudah dihapus.
# Semua kunci di bawah biasanya diisi lewat /admin/settings, bukan di sini.
POPPAY_API_BASE_URL=""
POPPAY_URL=""
POPPAY_PORT=""
POPPAY_VERSION=""
POPPAY_INTEGRATOR_TOKEN=""
POPPAY_AGGREGATOR_CODE=""
POPPAY_MERCHANT_ACCOUNT_NUMBER=""
POPPAY_SECRET_KEY=""
POPPAY_EMAIL=""
POPPAY_PASSWORD=""

# Fee QRIS yang ditambahkan ke tagihan pelanggan.
PAYMENT_GATEWAY_QRIS_FEE_TYPE=FIXED
PAYMENT_GATEWAY_QRIS_FEE_VALUE=0

# Potongan platform atas margin kotor merchant.
MERCHANT_PLATFORM_FEE_TYPE=FIXED
MERCHANT_PLATFORM_FEE_VALUE=0


# ═══ NOTIFIKASI ══════════════════════════════════════════════════════════════
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# WhatsApp (Fonnte).
FONNTE_TOKEN=""


# ═══ PERILAKU APLIKASI ═══════════════════════════════════════════════════════
# "false" mengizinkan checkout tamu tanpa login.
REQUIRE_LOGIN_TO_PURCHASE=true
# "false" melewati verifikasi OTP saat pendaftaran.
REGISTER_OTP_REQUIRED=true


# ═══ SAPUAN REKONSILIASI ═════════════════════════════════════════════════════
# Menggantikan worker BullMQ yang dihapus. Berjalan di dalam proses server dan
# menanyakan ulang ke database order mana yang tersangkut di PAID /
# PROCESSING_PROVIDER, sehingga restart tidak menghilangkan jadwal apa pun.
# Lihat src/core/services/provider/reconcile-scheduler.service.ts.

RECONCILE_SWEEP_ENABLED=true
RECONCILE_SWEEP_INTERVAL_MS=60000
# Umur minimal sebuah order sebelum dianggap tersangkut. Jangan terlalu pendek:
# order yang baru dibayar memang sedang diproses.
RECONCILE_SWEEP_STALE_MINUTES=2
# Batas order per sapuan. Tiap order berarti satu panggilan ke API provider.
RECONCILE_SWEEP_BATCH=25


# ═══ LOGGING ═════════════════════════════════════════════════════════════════
# Semua opsional; nilai di bawah adalah bawaannya.
# Penjelasan lengkap: docs/LOGGING.md

# WAJIB di VPS. Format `time` di log memakai timezone proses; kalau ini tidak
# di-set (atau di-set UTC), offsetnya jadi +00:00, bukan +07:00.
TZ=Asia/Jakarta

LOG_LEVEL=info
LOG_APP_NAME=whuzpay

# Sebaiknya path absolut kalau dijalankan lewat PM2/systemd — cwd bisa berbeda.
LOG_DIR=./logs
LOG_FILE=app.json

# Rotasi: app.json → app.1.json.gz (terbaru) → … → app.10.json.gz
LOG_MAX_SIZE=10M
LOG_MAX_FILES=10

LOG_TO_FILE=true
LOG_TO_STDOUT=false
LOG_PRETTY=true

# Access log: false → hanya /api/* yang dicatat.
LOG_HTTP_PAGES=true
# RSC prefetch (<Link> saat hover) — sumber noise terbesar, default dimatikan.
LOG_HTTP_PREFETCH=false
