{
  "name": "whuz-app",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "tsc --noEmit && npm test",
    "postinstall": "prisma generate",
    "logs:tail": "tail -F logs/app.json | pino-pretty -t \"SYS:standard\" -i pid,app,env",
    "logs:errors": "grep -hE '\"level\":\"(error|fatal)\"' logs/app.json 2>/dev/null | pino-pretty -t \"SYS:standard\" -i pid,app,env",
    "db:migrate:local": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "db:push:local": "dotenv -e .env.local -- prisma db push",
    "db:push": "prisma db push",
    "db:push:prod": "dotenv -e .env.production -- prisma db push",
    "db:studio:local": "dotenv -e .env.local -- prisma studio",
    "db:studio": "prisma studio",
    "db:seed:users": "dotenv -e .env.local -- tsx prisma/seed-users.ts",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed-admin.ts && dotenv -e .env.local -- tsx prisma/seed-tiers.ts && dotenv -e .env.local -- tsx prisma/seed-users.ts && dotenv -e .env.local -- tsx prisma/seed-page-content.ts && dotenv -e .env.local -- tsx prisma/seed-vouchers.ts",
    "test": "DATABASE_URL=\"mysql://root:testpass@127.0.0.1:3399/whuz_test\" vitest run",
    "test:watch": "DATABASE_URL=\"mysql://root:testpass@127.0.0.1:3399/whuz_test\" vitest",
    "test:db:up": "docker start whuz-test-mysql 2>/dev/null || docker run -d --name whuz-test-mysql -e MYSQL_ROOT_PASSWORD=testpass -e MYSQL_DATABASE=whuz_test -p 3399:3306 mysql:8.4",
    "test:db:push": "DATABASE_URL=\"mysql://root:testpass@127.0.0.1:3399/whuz_test\" prisma db push --skip-generate --accept-data-loss",
    "test:db:down": "docker rm -f whuz-test-mysql"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "iron-session": "^8.0.4",
    "next": "16.1.6",
    "nodemailer": "^6.9.16",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-quill-new": "^3.8.3",
    "rotating-file-stream": "^3.2.10",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
